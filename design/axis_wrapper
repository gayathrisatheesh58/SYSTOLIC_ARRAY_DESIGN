`timescale 1ns / 1ps

//=====================================================================
// AXI4-STREAM WRAPPER FOR 4x4 SYSTOLIC ARRAY
//
// AXI DATA WIDTH = 32 bits
//
// INPUT PACKET
//
//   Word 0 : W[0][0] W[0][1] W[0][2] W[0][3]
//   Word 1 : W[1][0] W[1][1] W[1][2] W[1][3]
//   Word 2 : W[2][0] W[2][1] W[2][2] W[2][3]
//   Word 3 : W[3][0] W[3][1] W[3][2] W[3][3]
//
//   Word 4 : Activation row 0
//   Word 5 : Activation row 1
//   Word 6 : Activation row 2
//   Word 7 : Activation row 3
//
// OUTPUT PACKET
//
//   Word 0 : Column 0 result
//   Word 1 : Column 1 result
//   Word 2 : Column 2 result
//   Word 3 : Column 3 result
//
//=====================================================================

module axis_systolic_array #(
    parameter DATA_WIDTH = 8,
    parameter AXIS_WIDTH = 32
)(
    //=================================================================
    // CLOCK / RESET
    //=================================================================

    input  wire aclk,
    input  wire aresetn,

    //=================================================================
    // AXI4-STREAM INPUT
    //=================================================================

    input  wire [AXIS_WIDTH-1:0] s_axis_tdata,
    input  wire                  s_axis_tvalid,
    output wire                  s_axis_tready,
    input  wire                  s_axis_tlast,

    //=================================================================
    // AXI4-STREAM OUTPUT
    //=================================================================

    output wire [AXIS_WIDTH-1:0] m_axis_tdata,
    output wire                  m_axis_tvalid,
    input  wire                  m_axis_tready,
    output wire                  m_axis_tlast
);

    //=================================================================
    // PARAMETERS
    //=================================================================

    localparam NUM_ROWS  = 4;
    localparam NUM_COLS  = 4;
    localparam ACC_WIDTH = (2 * DATA_WIDTH) + 1;

    //=================================================================
    // CONTROLLER STATES
    //=================================================================

    localparam S_RECEIVE = 2'd0;
    localparam S_START   = 2'd1;
    localparam S_WAIT    = 2'd2;
    localparam S_OUTPUT  = 2'd3;

    reg [1:0] state;

    //=================================================================
    // RESET
    //=================================================================

    wire rst;

    assign rst = ~aresetn;

    //=================================================================
    // INPUT MATRICES
    //
    // 128 bits for a 4x4 matrix with 8-bit elements.
    //
    // weight_flat:
    //   [  7:  0] = W[0][0]
    //   [ 15:  8] = W[0][1]
    //   ...
    //   [127:120] = W[3][3]
    //
    // matrix_a_flat:
    //   [  7:  0] = A[0][0]
    //   [ 15:  8] = A[0][1]
    //   ...
    //   [127:120] = A[3][3]
    //=================================================================

    reg signed
        [NUM_ROWS*NUM_COLS*DATA_WIDTH-1:0] weight_flat;

    reg signed
        [NUM_ROWS*NUM_COLS*DATA_WIDTH-1:0] matrix_a_flat;

    //=================================================================
    // DUT CONTROL / OUTPUT SIGNALS
    //=================================================================

    reg  start;

    wire dut_out_valid;
    wire dut_busy;
    wire dut_done;

    wire signed
        [NUM_COLS*ACC_WIDTH-1:0] acc_out;

    //=================================================================
    // INPUT WORD COUNTER
    //
    // 0 - 3 : weight words
    // 4 - 7 : activation words
    //=================================================================

    reg [3:0] input_count;

    //=================================================================
    // OUTPUT CONTROL
    //
    // 0 - 3 : four output words
    //=================================================================

    reg [1:0] output_count;

    reg output_valid;

    reg [AXIS_WIDTH-1:0] output_data;

    //=================================================================
    // AXI INPUT READY
    //
    // Accept input only during the RECEIVE state.
    //=================================================================

    assign s_axis_tready = (state == S_RECEIVE);

    //=================================================================
    // AXI OUTPUT
    //=================================================================

    assign m_axis_tdata  = output_data;

    assign m_axis_tvalid = output_valid;

    // TLAST is asserted on the fourth output word.
    assign m_axis_tlast =
        output_valid && (output_count == 2'd3);

    //=================================================================
    // SYSTOLIC ARRAY TOP-LEVEL DUT
    //
    // AXIS wrapper connects to the existing DUT top.
    //
    // The DUT internally contains:
    //
    //   systolic_array_4x4_top
    //          |
    //          +-- matrix_feeder
    //          |
    //          +-- systolic_array_4x4
    //=================================================================

    systolic_array_4x4_top #(
        .NUM_ROWS   (NUM_ROWS),
        .NUM_COLS   (NUM_COLS),
        .DATA_WIDTH (DATA_WIDTH)
    ) dut (
        .clk           (aclk),
        .rst           (rst),
        .start         (start),

        .matrix_a_flat (matrix_a_flat),
        .weight_flat   (weight_flat),

        .acc_out       (acc_out),
        .out_valid     (dut_out_valid),
        .busy          (dut_busy),
        .done          (dut_done)
    );

    //=================================================================
    // AXI / DUT CONTROLLER
    //=================================================================

    always @(posedge aclk) begin

        //=============================================================
        // RESET
        //=============================================================

        if (rst) begin

            state        <= S_RECEIVE;

            start        <= 1'b0;

            input_count  <= 4'd0;

            output_count <= 2'd0;

            output_valid <= 1'b0;

            weight_flat  <= '0;

            matrix_a_flat <= '0;

        end

        else begin

            //=========================================================
            // DEFAULT
            //
            // start is normally LOW.
            //
            // It becomes HIGH only in S_START for one clock.
            //=========================================================

            start <= 1'b0;

            case (state)

                //=====================================================
                // STATE 1 : RECEIVE INPUT PACKET
                //=====================================================

                S_RECEIVE: begin

                    if (s_axis_tvalid && s_axis_tready) begin

                        //-------------------------------------------------
                        // WORDS 0-3
                        //
                        // Store weight matrix.
                        //-------------------------------------------------

                        if (input_count < 4) begin

                            weight_flat[
                                input_count*AXIS_WIDTH +:
                                AXIS_WIDTH
                            ] <= s_axis_tdata;

                        end

                        //-------------------------------------------------
                        // WORDS 4-7
                        //
                        // Store activation matrix.
                        //-------------------------------------------------

                        else begin

                            matrix_a_flat[
                                (input_count - 4)*AXIS_WIDTH +:
                                AXIS_WIDTH
                            ] <= s_axis_tdata;

                        end

                        //-------------------------------------------------
                        // LAST INPUT WORD
                        //
                        // After Word 7, all input data has been
                        // collected.
                        //-------------------------------------------------

                        if (input_count == 4'd7) begin

                            input_count <= 4'd0;

                            state <= S_START;

                        end

                        //-------------------------------------------------
                        // MORE INPUT WORDS REQUIRED
                        //-------------------------------------------------

                        else begin

                            input_count <= input_count + 1'b1;

                        end

                    end

                end


                //=====================================================
                // STATE 2 : START DUT
                //=====================================================

                S_START: begin

                    // Generate one-clock start pulse.
                    start <= 1'b1;

                    // Move immediately to WAIT state.
                    state <= S_WAIT;

                end


                //=====================================================
                // STATE 3 : WAIT FOR DUT
                //=====================================================

                S_WAIT: begin

                    // Do not accept new AXI input here.
                    //
                    // Wait until matrix_feeder reports that the
                    // systolic computation is complete.

                    if (dut_out_valid) begin

                        output_count <= 2'd0;

                        output_valid <= 1'b1;

                        state <= S_OUTPUT;

                    end

                end


                //=====================================================
                // STATE 4 : SEND OUTPUT PACKET
                //=====================================================

                S_OUTPUT: begin

                    // AXI transfer occurs only when:
                    //
                    // VALID = 1
                    // READY = 1

                    if (output_valid && m_axis_tready) begin

                        //-------------------------------------------------
                        // FOURTH / LAST OUTPUT WORD
                        //-------------------------------------------------

                        if (output_count == 2'd3) begin

                            output_valid <= 1'b0;

                            output_count <= 2'd0;

                            input_count <= 4'd0;

                            // Ready to receive another packet.
                            state <= S_RECEIVE;

                        end

                        //-------------------------------------------------
                        // MOVE TO NEXT OUTPUT WORD
                        //-------------------------------------------------

                        else begin

                            output_count <= output_count + 1'b1;

                        end

                    end

                end


                //=====================================================
                // SAFETY DEFAULT
                //=====================================================

                default: begin

                    state        <= S_RECEIVE;

                    start        <= 1'b0;

                    input_count  <= 4'd0;

                    output_count <= 2'd0;

                    output_valid <= 1'b0;

                end

            endcase

        end

    end

    //=================================================================
    // OUTPUT DATA MUX
    //
    // ACC_WIDTH = 17 bits for DATA_WIDTH = 8.
    //
    // acc_out:
    //
    //   acc_out[16:0]    -> Column 0
    //   acc_out[33:17]   -> Column 1
    //   acc_out[50:34]   -> Column 2
    //   acc_out[67:51]   -> Column 3
    //
    // Each result is placed in the lower 17 bits of the
    // 32-bit AXI output word.
    //=================================================================

    always @(*) begin

        // Default output word.
        output_data = {AXIS_WIDTH{1'b0}};

        case (output_count)

            //=========================================================
            // OUTPUT WORD 0
            //=========================================================

            2'd0: begin

                output_data[ACC_WIDTH-1:0] =
                    acc_out[ACC_WIDTH-1:0];

            end

            //=========================================================
            // OUTPUT WORD 1
            //=========================================================

            2'd1: begin

                output_data[ACC_WIDTH-1:0] =
                    acc_out[(2*ACC_WIDTH)-1:
                            ACC_WIDTH];

            end

            //=========================================================
            // OUTPUT WORD 2
            //=========================================================

            2'd2: begin

                output_data[ACC_WIDTH-1:0] =
                    acc_out[(3*ACC_WIDTH)-1:
                            (2*ACC_WIDTH)];

            end

            //=========================================================
            // OUTPUT WORD 3
            //=========================================================

            2'd3: begin

                output_data[ACC_WIDTH-1:0] =
                    acc_out[(4*ACC_WIDTH)-1:
                            (3*ACC_WIDTH)];

            end

            //=========================================================
            // DEFAULT
            //=========================================================

            default: begin

                output_data = {AXIS_WIDTH{1'b0}};

            end

        endcase

    end

endmodule


